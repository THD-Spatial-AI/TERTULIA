# Project-root environment file — used by Docker Compose for variable
# interpolation (docker-compose.yml). This is SEPARATE from
# backend/.env, which holds the FastAPI application's secrets.
#
# Copy this to `.env` (the installer does it for you) and keep it out of git.
#
#   cp .env.example .env
#
# n8n encryption key — encrypts all credentials stored inside n8n.
# MUST be unique per machine and kept secret. Generate a random 32+ char value:
#   Linux/macOS : openssl rand -hex 32
#   Windows     : powershell -Command "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
# The installers generate this automatically if .env does not exist.
N8N_ENCRYPTION_KEY=
