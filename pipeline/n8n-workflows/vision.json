{
  "id": "FeedbackVision01",
  "name": "Feedback — Vision (qwen2.5vl:7b)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vision",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1111111-1111-1111-1111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "feedback-vision"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const inp = $input.item.json.body ?? $input.item.json;\nconst body = {\n  model: 'qwen2.5vl:7b',\n  messages: [\n    { role: 'system', content: inp.system_prompt },\n    { role: 'user', content: inp.user_text }\n  ],\n  stream: false\n};\nif (inp.image_b64) {\n  body.messages[1].images = [inp.image_b64];\n}\nreturn { json: { body } };"
      },
      "id": "b2222222-2222-2222-2222-222222222222",
      "name": "Build Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "c3333333-3333-3333-3333-333333333333",
      "name": "Call Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { content: $json.message.content } }}",
        "options": {}
      },
      "id": "d4444444-4444-4444-4444-444444444444",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Build Body",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Body": {
      "main": [
        [
          {
            "node": "Call Ollama",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Ollama": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
