# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (NEVER expose to frontend — full DB access)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# feeedback_pipeline backend URL (local or deployed)
# Use https:// for any non-local deployment — persona data and session tokens
# are POSTed to this URL.
PIPELINE_API_URL=http://localhost:9000

# Shared secret token — must match WORKSHOP_TOKEN in feeedback_pipeline/.env
PIPELINE_TOKEN=change-me-to-a-random-secret

# Wildfire application base URL (used to construct redirect URLs)
WILDFIRE_BASE_URL=https://wildfire.thd-spatial-ai.de

# App secret key (used for internal token signing)
APP_SECRET_KEY=change-me-to-a-32-char-random-string

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://workshop.thd-spatial-ai.de

# Log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Expose interactive API docs (/docs, /redoc, /openapi.json). Keep false in
# production so endpoints and schemas are not enumerable. Set true for local dev.
ENABLE_DOCS=false
