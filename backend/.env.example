# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://tertulia:tertulia@localhost:5435/tertulia

# ── Go authentication service ────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8002
AUTH_REALM=tertulia
# Must exactly match AUTH_INTERNAL_SECRET in the auth service config.
# Generate: openssl rand -base64 48
AUTH_INTERNAL_SECRET=change-me-to-a-48-byte-random-secret

# ── feeedback_pipeline backend ───────────────────────────────────────────────
PIPELINE_API_URL=http://localhost:9000
PIPELINE_TOKEN=change-me-to-a-random-secret

# ── Wildfire application base URL ────────────────────────────────────────────
WILDFIRE_BASE_URL=https://wildfire.thd-spatial-ai.de

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Log level ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── API docs (/docs, /redoc). Keep false in production. ──────────────────────
ENABLE_DOCS=true
