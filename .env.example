# Tertulia — docker-compose environment
# Copy to .env: make env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=tertulia
POSTGRES_PASSWORD=tertulia
POSTGRES_DB=tertulia
POSTGRES_PORT=5435

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8185
KC_HOSTNAME=localhost

# Keycloak client for the tertulia realm
KEYCLOAK_CLIENT_ID=tertulia-auth
# Create client secret in Keycloak admin console, then paste here
KEYCLOAK_CLIENT_SECRET=

# ── Auth service ──────────────────────────────────────────────────────────────
AUTH_PORT=8002
AUTH_REALM=tertulia
# Generate: openssl rand -base64 48
AUTH_INTERNAL_SECRET=
FRONTEND_URL=http://localhost:8080

# ── Storcito monorepo path (needed to build auth-service) ────────────────────
# Absolute or relative path to the storcito monorepo root
STORCITO_REPO_PATH=../storcito

# ── Tertulia backend ──────────────────────────────────────────────────────────
BACKEND_PORT=8010
LOG_LEVEL=INFO

# ── Tertulia frontend ─────────────────────────────────────────────────────────
FRONTEND_PORT=8080
VITE_AUTH_SERVICE_URL=http://localhost:8002
VITE_DEFAULT_LANG=en
