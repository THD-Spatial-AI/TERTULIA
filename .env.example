# Docker Compose environment variables
# Copy to .env:  make env  (or copy manually)
# This file is read automatically by docker compose from the project root.

# ── Host port mappings (change if host ports conflict) ───────────────────────
# Backend internal port is always 8001; only the HOST-side port is mapped here.
BACKEND_PORT=8010
FRONTEND_PORT=8080

# ── Frontend build-time variables (passed as Docker build args) ───────────────
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# URL the browser uses to reach the backend (must match BACKEND_PORT above)
VITE_BACKEND_URL=http://localhost:8010
VITE_DEFAULT_LANG=en

# ── Optional ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
