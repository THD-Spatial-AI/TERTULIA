# Tertulia — docker-compose environment
# Copy to .env: make env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=tertulia
POSTGRES_PASSWORD=tertulia
POSTGRES_DB=tertulia
POSTGRES_PORT=5435

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8185
KC_HOSTNAME=localhost

# Keycloak client for the tertulia realm
KEYCLOAK_CLIENT_ID=tertulia-auth
# Create client secret in Keycloak admin console, then paste here
KEYCLOAK_CLIENT_SECRET=

# ── Auth service ──────────────────────────────────────────────────────────────
AUTH_PORT=8002
AUTH_REALM=tertulia
# Generate: openssl rand -base64 48
AUTH_INTERNAL_SECRET=
FRONTEND_URL=http://localhost:8080

# ── Storcito monorepo path (needed to build auth-service) ────────────────────
# Absolute or relative path to the storcito monorepo root
STORCITO_REPO_PATH=../storcito

# ── Tertulia backend ──────────────────────────────────────────────────────────
BACKEND_PORT=8010
LOG_LEVEL=INFO

# ── Tertulia frontend ─────────────────────────────────────────────────────────
FRONTEND_PORT=8080
VITE_AUTH_SERVICE_URL=http://localhost:8002
VITE_DEFAULT_LANG=en

# ── Feedback pipeline (workshop → software → GitHub issue) ─────────────────────
# Single source of truth for the workshop token. This same value is the
# pipeline's WORKSHOP_TOKEN and the overlay's workshopToken. Rotate per workshop.
PIPELINE_TOKEN=change-me-to-a-random-secret
PIPELINE_PORT=9000

# Default target app participants launch into after the workshop.
WILDFIRE_BASE_URL=https://wildfire.thd-spatial-ai.de

# GitHub repo where feedback issues are filed (needs a token with repo+workflow).
GITHUB_TOKEN=
GITHUB_REPO=THD-Spatial-AI/Storcito-Wildfire

# Origins allowed to POST feedback to the pipeline (the deployed target app).
PIPELINE_ALLOWED_ORIGINS=https://wildfire-app.th-deg.de

# The software under test — drives the AI issue-generation prompts. Change these
# to reuse the pipeline against your own app (Wildfire is just the example).
TARGET_APP_NAME=Wildfire App
TARGET_APP_DESCRIPTION=a geospatial wildfire risk simulation platform used by municipalities, firefighters, mayors, and emergency management professionals

# ── Local inference (Ollama + n8n) ─────────────────────────────────────────────
OLLAMA_PORT=11434
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678
# Per-machine key — `make env` generates one. Never share it across installs.
N8N_ENCRYPTION_KEY=

# OPTIONAL cloud accelerator for issue text. Leave empty to run fully
# self-hosted on local Ollama (the canonical path).
GROQ_API_KEY=
